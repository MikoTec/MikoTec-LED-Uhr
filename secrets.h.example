#ifndef SECRETS_H
#define SECRETS_H
// Vorlage: nach secrets.h kopieren und den echten geteilten Telemetrie-Key eintragen.
// Dieser Key muss mit SHARED_KEY in /etc/uhr-telemetry/config.env auf dem
// Telemetrie-Server uebereinstimmen. secrets.h ist per .gitignore NICHT im Repo.
#define TELEMETRY_SHARED_KEY "HIER_GETEILTEN_KEY_EINTRAGEN"
#endif
