# Vorlage fuer /etc/uhr-devices-sync/config.env  (chmod 600, chown root:root)
# URL der Fleet-Web-App auf .25 (LAN-intern) + Pull-Token (muss mit
# PULL_TOKEN in der Fleet-Web config.env uebereinstimmen).
FLEET_URL=http://192.168.10.25:8080/api/devices.json
PULL_TOKEN=HIER_PULL_TOKEN_EINTRAGEN
DEST=/etc/uhr-telemetry/devices.json
OWNER=root:uhrtel
