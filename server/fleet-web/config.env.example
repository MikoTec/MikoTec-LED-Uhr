# Vorlage fuer /etc/uhr-fleet/config.env  (chmod 640, chown root:uhrfleet)
# Echte Secrets gehoeren NICHT ins Repo - nur hier als Platzhalter.

# --- InfluxDB (liegt lokal auf dieser VM) ---
INFLUX_URL=http://127.0.0.1:8086
INFLUX_ORG=mikotec
INFLUX_BUCKET=uhren
# READ-Token (nur Lesen auf Bucket "uhren"). In InfluxDB anlegen:
#   Data -> API Tokens -> Custom API Token -> Read: uhren
INFLUX_READ_TOKEN=HIER_READ_ONLY_TOKEN_EINTRAGEN

# --- Netzwerk / LOKAL ONLY ---
# NUR an die LAN-IP binden, niemals 0.0.0.0. Niemals per FRITZ!Box freigeben.
LISTEN_ADDR=192.168.10.25
LISTEN_PORT=8080

# --- Zugriff ---
# Admin-Passwort fuer die Weboberflaeche. Leer lassen = kein Login
# (nur im vertrauenswuerdigen LAN vertretbar). Empfehlung: setzen.
ADMIN_PASSWORD=
# Pull-Token: der Sync auf dem update-server (.20) schickt ihn im Header
# X-Pull-Token, um /api/devices.json abzuholen. Mit `openssl rand -hex 24`.
PULL_TOKEN=HIER_PULL_TOKEN_EINTRAGEN
# Flask-Session-Secret (wird vom Installer gesetzt).
SECRET_KEY=HIER_RANDOM_HEX_EINTRAGEN

# --- Darstellung ---
# online, wenn letzter Heartbeat juenger als so viele Sekunden (Default 1200).
ONLINE_WINDOW_S=1200
# Zeitfenster der Live-Abfrage.
LOOKBACK=30d
