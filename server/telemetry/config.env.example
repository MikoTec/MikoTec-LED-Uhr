# Vorlage fuer /etc/uhr-telemetry/config.env
# Echte Datei auf dem update-server anlegen, chmod 640, chown root:uhrtel.
# ACHTUNG: Die echten Secrets gehoeren NICHT ins Repo - nur hier als Platzhalter.
INFLUX_URL=http://192.168.10.25:8086
INFLUX_ORG=mikotec
INFLUX_BUCKET=uhren
INFLUX_TOKEN=HIER_WRITE_ONLY_TOKEN_EINTRAGEN
# Geteilter Firmware-Key (muss mit TELEMETRY_SHARED_KEY in der Firmware-secrets.h uebereinstimmen)
SHARED_KEY=HIER_GETEILTEN_FW_KEY_EINTRAGEN
LISTEN_PORT=8099
